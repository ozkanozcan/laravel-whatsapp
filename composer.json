{
    "name": "ozkanozcan/laravel-whatsapp",
    "description": "Laravel 10-13 WhatsApp Business notification channel package via Meta Cloud API",
    "keywords": ["laravel", "whatsapp", "notification", "whatsapp-business", "meta", "channel"],
    "homepage": "https://github.com/ozkanozcan/laravel-whatsapp",
    "license": "MIT",
    "authors": [
        {
            "name": "Özkan Özcan",
            "email": "ozkan@ozcanyazilim.com.tr",
            "homepage": "https://ozcanyazilim.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "OzkanOzcan\\LaravelWhatsapp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OzkanOzcan\\LaravelWhatsapp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OzkanOzcan\\LaravelWhatsapp\\WhatsappServiceProvider"
            ],
            "aliases": {
                "Whatsapp": "OzkanOzcan\\LaravelWhatsapp\\WhatsappFacade"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
